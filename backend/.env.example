DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5432/investment_db

# REQUIRED. Secret used to sign login tokens (at least 32 characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit it. Changing it logs every user out.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Optional: login token lifetime in minutes (default 480 = 8 hours).
# JWT_EXPIRE_MINUTES=480

# Optional settings (all off by default)
# Comma-separated list of allowed frontend origins (defaults to localhost:5173).
# CORS_ORIGINS=http://localhost:5173
# Expose diagnostic endpoints /api/db-test, /api/db-stats, /api/cache/clear. Keep off in production.
# ENABLE_DEBUG_ENDPOINTS=true
# On startup, import investment_db_inserts.sql into an EMPTY database (only if investment_opportunities does not exist).
# AUTO_SEED_DB=true
